<?xml version="1.0"?>
<sdf version="1.6">
  <world name="complex_world">

    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>
    <physics name="default" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>

    <!-- SEGMENT 1: Start straight -->
    <model name="seg1"><static>true</static><pose>-1.75 0.0 0.001 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>2.5 0.12 0.001</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>2.5 0.12 0.001</size></box></geometry></collision>
      </link></model>

    <!-- SEGMENT 2: Turn down at x=-0.5 -->
    <model name="seg2"><static>true</static><pose>-0.5 -1.0 0.001 0 0 1.5708</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>2.0 0.12 0.001</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>2.0 0.12 0.001</size></box></geometry></collision>
      </link></model>

    <!-- SEGMENT 3a: Straight left, before gap 1 -->
    <model name="seg3a"><static>true</static><pose>-1.25 -2.0 0.001 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>1.5 0.12 0.001</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>1.5 0.12 0.001</size></box></geometry></collision>
      </link></model>

    <!-- GAP 1: 0.3m gap from x=-2.0 to x=-2.3 -->

    <!-- SEGMENT 3b: After gap 1 -->
    <model name="seg3b"><static>true</static><pose>-2.65 -2.0 0.001 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>0.9 0.12 0.001</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>0.9 0.12 0.001</size></box></geometry></collision>
      </link></model>

    <!-- SEGMENT 4: Turn up at x=-3.1 -->
    <model name="seg4"><static>true</static><pose>-3.1 -1.0 0.001 0 0 1.5708</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>2.0 0.12 0.001</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>2.0 0.12 0.001</size></box></geometry></collision>
      </link></model>

    <!-- SEGMENT 5: Straight right back to centre -->
    <model name="seg5"><static>true</static><pose>-2.3 0.0 0.001 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>1.6 0.12 0.001</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>1.6 0.12 0.001</size></box></geometry></collision>
      </link></model>

    <!-- SEGMENT 6: S-curve down -->
    <model name="seg6a"><static>true</static><pose>0.5 -0.35 0.001 0 0 1.5708</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>0.7 0.12 0.001</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>0.7 0.12 0.001</size></box></geometry></collision>
      </link></model>

    <model name="seg6b"><static>true</static><pose>0.85 -0.7 0.001 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>0.7 0.12 0.001</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>0.7 0.12 0.001</size></box></geometry></collision>
      </link></model>

    <model name="seg6c"><static>true</static><pose>1.2 -0.35 0.001 0 0 1.5708</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>0.7 0.12 0.001</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>0.7 0.12 0.001</size></box></geometry></collision>
      </link></model>

    <!-- SEGMENT 7a: Straight right after S -->
    <model name="seg7a"><static>true</static><pose>1.85 0.0 0.001 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>1.3 0.12 0.001</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>1.3 0.12 0.001</size></box></geometry></collision>
      </link></model>

    <!-- GAP 2: 0.3m gap from x=2.5 to x=2.8 -->

    <!-- SEGMENT 7b: After gap 2 -->
    <model name="seg7b"><static>true</static><pose>3.05 0.0 0.001 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>0.9 0.12 0.001</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>0.9 0.12 0.001</size></box></geometry></collision>
      </link></model>

    <!-- SEGMENT 8: Turn down at x=3.5 -->
    <model name="seg8"><static>true</static><pose>3.5 -1.2 0.001 0 0 1.5708</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>2.4 0.12 0.001</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>2.4 0.12 0.001</size></box></geometry></collision>
      </link></model>

    <!-- SEGMENT 9: Finish straight -->
    <model name="seg9"><static>true</static><pose>1.5 -2.4 0.001 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>4.0 0.12 0.001</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>4.0 0.12 0.001</size></box></geometry></collision>
      </link></model>

    <!-- OBSTACLE 1 -->
    <model name="obstacle_1"><static>true</static><pose>-1.0 0.0 0.15 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>0.25 0.25 0.3</size></box></geometry>
          <material><ambient>1 0.2 0.2 1</ambient><diffuse>1 0.2 0.2 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>0.25 0.25 0.3</size></box></geometry></collision>
      </link></model>

    <!-- OBSTACLE 2 -->
    <model name="obstacle_2"><static>true</static><pose>3.05 0.0 0.15 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>0.25 0.25 0.3</size></box></geometry>
          <material><ambient>1 0.2 0.2 1</ambient><diffuse>1 0.2 0.2 1</diffuse></material></visual>
        <collision name="c"><geometry><box><size>0.25 0.25 0.3</size></box></geometry></collision>
      </link></model>

  </world>
</sdf>
